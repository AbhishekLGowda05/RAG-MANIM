# Copy to .env and fill in your keys (never commit .env)
# OPENAI_API_KEY is used by LiteLLM for optional cloud fallbacks
OPENAI_API_KEY=

# Google / Gemini (PageIndex may read GOOGLE_API_KEY or GEMINI_API_KEY)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Optional: Ollama runs locally for PageIndex CPU mode (default model in config.yaml)
# Ensure `ollama serve` is running and models are pulled, e.g. ollama pull qwen2.5:3b
